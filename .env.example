# ===== Ứng dụng =====
APP_NAME=DVT - Bảng điều hành
# BẮT BUỘC đổi trên môi trường thật (chuỗi ngẫu nhiên dài >= 32 ký tự)
JWT_SECRET=change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=480
TIMEZONE=Asia/Ho_Chi_Minh
# Đơn vị hiển thị của doanh thu (số liệu ERP không kèm đơn vị — xác nhận với kế toán)
REVENUE_UNIT=USD

# ===== PostgreSQL (DB cache cho dashboard) =====
POSTGRES_DSN=postgresql+psycopg2://dhdvt:dhdvt@localhost:5432/dhdvt

# ===== SQL Server nguồn (ERP eGMF) =====
SQLSERVER_HOST=10.8.0.72
SQLSERVER_PORT=1433
SQLSERVER_DB=eGMF
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TIMEOUT=15
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# ===== Vận hành =====
# Bật job nền đồng bộ eGMF 1 lần/ngày (giờ cấu hình ở màn hình Sync Log)
SCHEDULER_ENABLED=true
# Cảnh báo khi file kế hoạch cũ hơn N ngày / dữ liệu eGMF chưa làm mới sau N giờ
PLAN_STALE_DAYS=45
SYNC_STALE_HOURS=36
# Chỉ cần khi chạy dev frontend riêng (Vite) — trên IIS cùng origin nên không cần
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Planning Core =====
# Quá số giây này không heartbeat thì phiên soạn thảo hết hạn (nhả khóa)
PLANNING_SESSION_TIMEOUT_SECONDS=180
# true = chỉ Issue được phiên bản có Recheck = PASS (đúng handoff); false = cho phép cả WARNING
PLANNING_ISSUE_REQUIRES_PASS=true
